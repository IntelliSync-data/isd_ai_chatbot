<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_ai_chatbot" model="ir.module.category">
        <field name="name">AI Chatbot</field>
        <field name="sequence">60</field>
    </record>

    <!-- Same ladder as isd_chatbot: a user works their own leads, an editor
         keeps the answers up to date, a manager does both for everyone, an
         admin also holds the keys -->
    <record id="group_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_ai_chatbot"/>
        <field name="comment">Works the leads assigned to them, and reads their conversations.</field>
    </record>
    <record id="group_editor" model="res.groups">
        <field name="name">Editor</field>
        <field name="category_id" ref="module_category_ai_chatbot"/>
        <field name="comment">Keeps the knowledge base and Q&amp;A up to date. Sees no leads.</field>
    </record>
    <record id="group_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_ai_chatbot"/>
        <field name="implied_ids" eval="[(4, ref('group_user')), (4, ref('group_editor'))]"/>
        <field name="comment">All leads and conversations, plus the knowledge base and Q&amp;A.</field>
    </record>
    <record id="group_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="category_id" ref="module_category_ai_chatbot"/>
        <field name="implied_ids" eval="[(4, ref('group_manager'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Settings, API keys, Zalo and Facebook credentials, webhook logs.</field>
    </record>

    <record id="rule_lead_user" model="ir.rule">
        <field name="name">Chatbot lead: own leads</field>
        <field name="model_id" ref="model_isd_ai_chatbot_lead"/>
        <field name="domain_force">[('assigned_user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_user'))]"/>
    </record>
    <record id="rule_lead_manager" model="ir.rule">
        <field name="name">Chatbot lead: all</field>
        <field name="model_id" ref="model_isd_ai_chatbot_lead"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_manager'))]"/>
    </record>
    <record id="rule_conversation_user" model="ir.rule">
        <field name="name">Chatbot conversation: of own leads</field>
        <field name="model_id" ref="model_isd_ai_chatbot_conversation"/>
        <field name="domain_force">[('lead_id.assigned_user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_user'))]"/>
    </record>
    <record id="rule_conversation_manager" model="ir.rule">
        <field name="name">Chatbot conversation: all</field>
        <field name="model_id" ref="model_isd_ai_chatbot_conversation"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_manager'))]"/>
    </record>
    <record id="rule_message_user" model="ir.rule">
        <field name="name">Chatbot message: of own leads</field>
        <field name="model_id" ref="model_isd_ai_chatbot_message"/>
        <field name="domain_force">[('conversation_id.lead_id.assigned_user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_user'))]"/>
    </record>
    <record id="rule_message_manager" model="ir.rule">
        <field name="name">Chatbot message: all</field>
        <field name="model_id" ref="model_isd_ai_chatbot_message"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_manager'))]"/>
    </record>
</odoo>
