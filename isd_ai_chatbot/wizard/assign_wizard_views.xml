<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_assign_wizard_form" model="ir.ui.view">
        <field name="name">isd.ai.chatbot.lead.assign.wizard.form</field>
        <field name="model">isd.ai.chatbot.lead.assign.wizard</field>
        <field name="arch" type="xml">
            <form string="Assign Lead">
                <p>Choose who handles this lead before continuing.</p>
                <group>
                    <field name="lead_id" readonly="1"/>
                    <field name="assigned_user_id" widget="many2one_avatar_user"/>
                    <field name="next_action" invisible="1"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Assign and Continue" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
