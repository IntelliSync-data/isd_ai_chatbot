<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Laid out like isd_chatbot. The app has no group of its own: Odoo hides
         it from anyone who can see none of the menus below. -->
    <!-- A menu's groups are only ever added on upgrade, so the ones earlier
         versions set are taken off with "-" -->
    <menuitem id="menu_root" name="AI Chatbot" sequence="45"
              web_icon="isd_ai_chatbot,static/description/icon.png"
              groups="-isd_ai_chatbot.group_user,-isd_ai_chatbot.group_editor"/>

    <menuitem id="menu_leads" name="Leads" parent="menu_root" sequence="5"
              action="action_lead" groups="isd_ai_chatbot.group_user"/>
    <menuitem id="menu_conversations" name="Conversations" parent="menu_root" sequence="10"
              action="action_conversation" groups="isd_ai_chatbot.group_user"/>
    <menuitem id="menu_webhook_logs" name="Webhook Logs" parent="menu_root" sequence="15"
              action="action_webhook_log" groups="isd_ai_chatbot.group_admin"/>

    <menuitem id="menu_configuration" name="Configuration" parent="menu_root" sequence="20"
              groups="isd_ai_chatbot.group_editor,-isd_ai_chatbot.group_admin"/>
    <menuitem id="menu_settings" name="Settings" parent="menu_configuration" sequence="5"
              action="action_config" groups="isd_ai_chatbot.group_admin"/>
    <menuitem id="menu_knowledge" name="Knowledge Base" parent="menu_configuration" sequence="10"
              action="action_knowledge" groups="isd_ai_chatbot.group_editor"/>
    <menuitem id="menu_qa" name="Q&amp;A" parent="menu_configuration" sequence="12"
              action="action_qa" groups="isd_ai_chatbot.group_editor"/>
    <menuitem id="menu_sources" name="Lead Sources" parent="menu_configuration" sequence="30"
              action="action_source" groups="isd_ai_chatbot.group_admin"/>
</odoo>
