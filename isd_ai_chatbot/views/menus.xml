<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <menuitem id="menu_root" name="AI Chatbot" sequence="45"
              web_icon="isd_ai_chatbot,static/description/icon.png"
              groups="isd_ai_chatbot.group_user,isd_ai_chatbot.group_editor"/>

    <menuitem id="menu_leads" name="Leads" parent="menu_root" sequence="10"
              action="action_lead" groups="isd_ai_chatbot.group_user"/>
    <menuitem id="menu_conversations" name="Conversations" parent="menu_root" sequence="20"
              action="action_conversation" groups="isd_ai_chatbot.group_user"/>

    <menuitem id="menu_content" name="Knowledge" parent="menu_root" sequence="30"
              groups="isd_ai_chatbot.group_editor"/>
    <menuitem id="menu_knowledge" name="Knowledge Base" parent="menu_content" sequence="10" action="action_knowledge"/>
    <menuitem id="menu_qa" name="Q&amp;A" parent="menu_content" sequence="20" action="action_qa"/>

    <menuitem id="menu_configuration" name="Configuration" parent="menu_root" sequence="90"
              groups="isd_ai_chatbot.group_admin"/>
    <menuitem id="menu_settings" name="Settings" parent="menu_configuration" sequence="10" action="action_config"/>
    <menuitem id="menu_sources" name="Lead Sources" parent="menu_configuration" sequence="20" action="action_source"/>
    <menuitem id="menu_webhook_logs" name="Webhook Logs" parent="menu_configuration" sequence="30"
              action="action_webhook_log"/>
</odoo>
