<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_source_list" model="ir.ui.view">
        <field name="name">isd.ai.chatbot.source.list</field>
        <field name="model">isd.ai.chatbot.source</field>
        <field name="arch" type="xml">
            <list string="Lead Sources" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="description" optional="show"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="action_source" model="ir.actions.act_window">
        <field name="name">Lead Sources</field>
        <field name="res_model">isd.ai.chatbot.source</field>
        <field name="view_mode">list</field>
        <field name="context">{'active_test': False}</field>
    </record>
</odoo>
