<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_knowledge_list" model="ir.ui.view">
        <field name="name">isd.ai.chatbot.knowledge.list</field>
        <field name="model">isd.ai.chatbot.knowledge</field>
        <field name="arch" type="xml">
            <list string="Knowledge Base">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="category" optional="show"/>
                <field name="source_type" optional="show"/>
                <field name="summary" optional="show"/>
                <field name="char_count" optional="hide"/>
                <field name="write_date" string="Updated" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_knowledge_form" model="ir.ui.view">
        <field name="name">isd.ai.chatbot.knowledge.form</field>
        <field name="model">isd.ai.chatbot.knowledge</field>
        <field name="arch" type="xml">
            <form string="Document">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_title"><h1><field name="name" placeholder="Document title"/></h1></div>
                    <group>
                        <group>
                            <field name="upload_file" filename="upload_filename"/>
                            <field name="upload_filename" invisible="1"/>
                            <field name="source_type"/>
                        </group>
                        <group>
                            <field name="category"/>
                            <field name="source_url" widget="url"/>
                            <field name="sequence"/>
                        </group>
                    </group>
                    <div class="text-muted mb-2">
                        Uploading a .docx fills the content below and keeps its headings. Start each section with
                        "## " on its own line: answers quote the section they came from.
                    </div>
                    <field name="content" nolabel="1" placeholder="## Section title&#10;Text of the section..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_knowledge_search" model="ir.ui.view">
        <field name="name">isd.ai.chatbot.knowledge.search</field>
        <field name="model">isd.ai.chatbot.knowledge</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="content"/>
                <field name="category"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Category" name="group_category" context="{'group_by': 'category'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_knowledge" model="ir.actions.act_window">
        <field name="name">Knowledge Base</field>
        <field name="res_model">isd.ai.chatbot.knowledge</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add what the bot should know</p>
            <p>Upload a Word file or type the text. The bot answers from these documents and cites them.</p>
        </field>
    </record>
</odoo>
