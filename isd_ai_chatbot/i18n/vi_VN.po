#. module: isd_ai_chatbot
#: model:mail.template,body_html:isd_ai_chatbot.mail_template_booking_agent
msgid ""
"<div style=\"font-family: Arial, sans-serif; font-size: 14px; color: #1e293b;\">\n"
"    <p>A consultation from the chatbot is booked for you.</p>\n"
"    <ul>\n"
"        <li>Customer: <strong t-out=\"object.name\"/></li>\n"
"        <li t-if=\"object.phone\">Phone: <t t-out=\"object.phone\"/></li>\n"
"        <li t-if=\"object.email\">Email: <t t-out=\"object.email\"/></li>\n"
"        <li>When: <strong t-out=\"format_datetime(object.consultation_datetime, tz=object.assigned_user_id.tz or 'UTC', dt_format='EEEE dd/MM/yyyy HH:mm')\"/></li>\n"
"        <li t-if=\"object.topic\">Topic: <t t-out=\"object.topic\"/></li>\n"
"        <li t-if=\"object.calendar_event_id.videocall_location\">Video call:\n"
"            <a t-att-href=\"object.calendar_event_id.videocall_location\" t-out=\"object.calendar_event_id.videocall_location\"/></li>\n"
"    </ul>\n"
"</div>\n"
"            "
msgstr ""

#. module: isd_ai_chatbot
#: model:mail.template,body_html:isd_ai_chatbot.mail_template_booking_customer
msgid ""
"<div style=\"font-family: Arial, sans-serif; font-size: 14px; color: #1e293b;\">\n"
"    <t t-if=\"object.lang == 'en'\">\n"
"        <p>Hello <t t-out=\"object.name\"/>,</p>\n"
"        <p>Your consultation is booked for\n"
"            <strong t-out=\"object.meeting_time_display\"/>.</p>\n"
"        <p>It will be with <strong t-out=\"object.assigned_user_id.name\"/>.</p>\n"
"        <p t-if=\"object.calendar_event_id.videocall_location\">Join the video call here:\n"
"            <a t-att-href=\"object.calendar_event_id.videocall_location\" t-out=\"object.calendar_event_id.videocall_location\"/></p>\n"
"        <p>See you then.</p>\n"
"    </t>\n"
"    <t t-else=\"\">\n"
"        <p>Xin chào <t t-out=\"object.name\"/>,</p>\n"
"        <p>Lịch tư vấn của bạn đã được đặt vào\n"
"            <strong t-out=\"object.meeting_time_display\"/>.</p>\n"
"        <p>Người tư vấn: <strong t-out=\"object.assigned_user_id.name\"/>.</p>\n"
"        <p t-if=\"object.calendar_event_id.videocall_location\">Tham gia cuộc gọi video tại:\n"
"            <a t-att-href=\"object.calendar_event_id.videocall_location\" t-out=\"object.calendar_event_id.videocall_location\"/></p>\n"
"        <p>Hẹn gặp bạn.</p>\n"
"    </t>\n"
"</div>\n"
"            "
msgstr ""

